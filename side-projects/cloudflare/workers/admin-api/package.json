{
  "name": "contentapp-cloudflare-admin-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node ../../../../scripts/ci/deploy_verified_side_project.mjs admin-api",
    "check": "tsc --noEmit",
    "test": "node -e \"fs.rmSync('.test-dist', {recursive: true, force: true})\" && tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run dry-run",
    "lint": "eslint src --max-warnings=0",
    "predeploy": "npm run verify",
    "dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "eslint": "^10.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^4.120.0"
  }
}

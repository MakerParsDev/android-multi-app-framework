{
  "name": "admin-notifications",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "inject:flavor-versions": "node scripts/inject-flavor-versions.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src test scripts vite.config.ts --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run lint && npm test && npm run build && node scripts/verify-build-metadata.mjs",
    "predeploy": "npm run verify",
    "deploy": "node ../../scripts/ci/deploy_verified_side_project.mjs admin-notifications"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.4",
    "undici": "^7.29.0"
  }
}
